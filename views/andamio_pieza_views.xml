<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_andamio_pieza_tree" model="ir.ui.view">
        <field name="name">andamio.pieza.tree</field>
        <field name="model">andamio.pieza</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="codigo"/>
                <field name="stock_total"/>
            </list>
        </field>
    </record>

    <record id="view_andamio_pieza_form" model="ir.ui.view">
        <field name="name">andamio.pieza.form</field>
        <field name="model">andamio.pieza</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="codigo"/>
                        <field name="stock_total"/>
                        <field name="image_1920" widget="image"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_andamio_pieza_kanban" model="ir.ui.view">
        <field name="name">andamio.pieza.kanban</field>
        <field name="model">andamio.pieza</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="codigo"/>
                <field name="stock_total"/>
                <field name="image_1920"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="o_kanban_image">
                                <field name="image_1920" widget="image"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                                <div><span>Código: </span><field name="codigo"/></div>
                                <div><span>Stock: </span><field name="stock_total"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_andamio_pieza" model="ir.actions.act_window">
        <field name="name">Piezas</field>
        <field name="res_model">andamio.pieza</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="menu_andamio_root" name="Gestión Andamios" action="action_andamio_obra"/>
    <menuitem id="menu_andamio_piezas" name="Piezas" parent="menu_andamio_root" action="action_andamio_pieza"/>
</odoo>
