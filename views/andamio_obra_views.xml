<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_andamio_root" name="Gestión Andamios"/>
    <record id="view_andamio_obra_tree" model="ir.ui.view">
        <field name="name">andamio.obra.tree</field>
        <field name="model">andamio.obra</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="ubicacion"/>
                <field name="encargado_id"/>
                <field name="cliente"/>
                <field name="total_andamios_obra"/>
                <field name="piezas_en_obra"/>
            </list>
        </field>
    </record>

    <record id="view_andamio_obra_form" model="ir.ui.view">
        <field name="name">andamio.obra.form</field>
        <field name="model">andamio.obra</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="ubicacion_id" options="{'no_create_edit': True}"/>
                        <field name="encargado_id" options="{'no_create_edit': True}"/>
                        <field name="cliente" readonly="1"/>
                        <field name="total_andamios_obra" readonly="1"/>
                        <field name="piezas_en_obra" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Movimientos">
                            <field name="movimiento_ids" readonly="1">
                                <list>
                                    <field name="fecha_entrega"/>
                                    <field name="tipo_movimiento"/>
                                    <field name="estado"/>
                                </list>
                            </field>
                        </page>
                        <page string="Stock">
                            <field name="stock_move_ids" readonly="1">
                                <list>
                                    <field name="product_id"/>
                                    <field name="product_uom_qty"/>
                                    <field name="location_id"/>
                                    <field name="location_dest_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_andamio_obra_kanban" model="ir.ui.view">
        <field name="name">andamio.obra.kanban</field>
        <field name="model">andamio.obra</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="ubicacion"/>
                <field name="encargado_id"/>
                <field name="cliente"/>
                <field name="total_andamios_obra"/>
                <field name="piezas_en_obra"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong><field name="name"/></strong>
                            <div><span>Ubicación: </span><field name="ubicacion"/></div>
                            <div><span>Cliente: </span><field name="cliente"/></div>
                            <div><span>Encargado: </span><field name="encargado_id"/></div>
                            <div><span>Total: </span><field name="total_andamios_obra"/></div>
                            <div><span>Piezas: </span><field name="piezas_en_obra"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_andamio_obra" model="ir.actions.act_window">
        <field name="name">Obras</field>
        <field name="res_model">andamio.obra</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_andamio_informe_obras" model="ir.actions.act_window">
        <field name="name">Informe Andamios por Obra</field>
        <field name="res_model">andamio.obra</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <menuitem id="menu_andamio_obras" name="Obras" parent="menu_andamio_root" action="action_andamio_obra"/>
    <menuitem id="menu_andamio_informe_obras" name="Informe Andamios por Obra" parent="menu_andamio_root" action="action_andamio_informe_obras" sequence="31"/>
</odoo>
